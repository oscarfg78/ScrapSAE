flowchart LR
    W["Wizard"] --> A["PageAnalysisResult\ncatálogo + detalle"]
    A --> D["Dictionary string/string\nDualSelector serializado"]
    D --> T["SiteProfile temporal\nMax=5"]
    T --> API["Endpoint normal de scraping"]
    API --> R["ScrapingRunner"]
    R --> EV["Variables de entorno globales\nheadless/login/learned URLs"]
    R --> DS["Descubrimiento denominado aditivo"]
    DS --> EV
    R --> K{"StrategyType keyed"}
    K -->|"Shopify"| SH["Shopify API\nprimera variante/imagen"]
    K -->|"Generic"| PW["PlaywrightScrapingService"]
    EV --> PW
    PW -->|"learned/direct URLs presentes"| ER["Retorno temprano\nScrapeDirectUrls"]
    PW -->|"sin pool"| OR["Orchestrator\nfirst non-empty"]
    OR --> DI["Direct"]
    OR --> LI["List"]
    OR --> FA["Families"]
    PW -->|"sin resultado"| LG["Fallback legacy\nheurísticas y casos nominales"]
    SH --> PP["Procesamiento IA + enriquecimiento"]
    ER --> PP
    DI --> PP
    LI --> PP
    FA --> PP
    LG --> PP
    PP --> ST["Staging\nupsert SiteId + SKU"]
    PP --> AU["Post-análisis\nmutación automática"]
    AU --> T
    ST --> Q["Consulta global y filtro del wizard"]
    Q --> PV["Preview parcial\nhasta 10"]

