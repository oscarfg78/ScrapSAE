<UserControl x:Class="ScrapSAE.Desktop.Views.CoverageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScrapSAE.Desktop.Views">
    <UserControl.Resources>
        <local:CoverageToBrushConverter x:Key="CoverageToBrush"/>
    </UserControl.Resources>

    <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="12,10" Background="#F9FAFB">
        <StackPanel>
            <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:CoverageCard}}"
                       FontSize="12" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,6"/>
            <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0}%">
                        <Binding Path="Coverage" RelativeSource="{RelativeSource AncestorType=local:CoverageCard}"/>
                    </MultiBinding>
                </TextBlock.Text>
                <TextBlock.Foreground>
                    <Binding Path="Coverage"
                             RelativeSource="{RelativeSource AncestorType=local:CoverageCard}"
                             Converter="{StaticResource CoverageToBrush}"/>
                </TextBlock.Foreground>
            </TextBlock>
            <ProgressBar Value="{Binding Coverage, RelativeSource={RelativeSource AncestorType=local:CoverageCard}}"
                         Maximum="100" Height="4" Margin="0,6,0,0"
                         Foreground="{Binding Coverage, RelativeSource={RelativeSource AncestorType=local:CoverageCard}, Converter={StaticResource CoverageToBrush}}"/>
        </StackPanel>
    </Border>
</UserControl>
