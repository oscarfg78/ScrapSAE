<Window x:Class="ScrapSAE.Desktop.Views.ConcurrentWizard.ConcurrentProviderWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ScrapSAE.Desktop.ViewModels.ConcurrentWizard"
        xmlns:views="clr-namespace:ScrapSAE.Desktop.Views.ConcurrentWizard"
        xmlns:local="clr-namespace:ScrapSAE.Desktop.Infrastructure"
        Title="Wizard de Scraping Concurrente" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="White">

    <Window.Resources>
        <!-- ── Color Palette ── -->
        <SolidColorBrush x:Key="BackgroundBrush"    Color="#1E1E2E"/>
        <SolidColorBrush x:Key="SurfaceBrush"       Color="#2A2A3E"/>
        <SolidColorBrush x:Key="AccentBrush"        Color="#7C3AED"/>
        <SolidColorBrush x:Key="AccentLightBrush"   Color="#A78BFA"/>
        <SolidColorBrush x:Key="SuccessBrush"       Color="#10B981"/>
        <SolidColorBrush x:Key="WarningBrush"       Color="#F59E0B"/>
        <SolidColorBrush x:Key="ErrorBrush"         Color="#EF4444"/>
        <SolidColorBrush x:Key="TextMutedBrush"     Color="#94A3B8"/>
        <SolidColorBrush x:Key="BorderBrush2"       Color="#3A3A5C"/>

        <!-- ── Styles ── -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background"   Value="#7C3AED"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="Padding"      Value="16,8"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#6D28D9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#3A3A5C"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2A2A3E"/>
        </Style>

        <Style x:Key="GreenButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#059669"/>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>

        <Style x:Key="StepCircle" TargetType="Border">
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Background" Value="#3A3A5C"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background"       Value="#2A2A3E"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#3A3A5C"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background"       Value="#2A2A3E"/>
            <Setter Property="Foreground"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#3A3A5C"/>
            <Setter Property="Padding"          Value="8,6"/>
        </Style>

        <!-- ── DataTemplates por Step ── -->
        <DataTemplate DataType="{x:Type vm:Step1ExcelIngestionViewModel}">
            <views:Step1ExcelIngestionView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:Step2TargetConfigViewModel}">
            <views:Step2TargetConfigView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:Step3SourcePriorityViewModel}">
            <views:Step3SourcePriorityView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:Step4ExecutionViewModel}">
            <views:Step4ExecutionView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Step Indicator -->
            <RowDefinition Height="*"/>     <!-- Step Content -->
            <RowDefinition Height="Auto"/>  <!-- Navigation Buttons -->
        </Grid.RowDefinitions>

        <!-- ── Step Indicator Bar ── -->
        <Border Grid.Row="0" Background="#2A2A3E" Padding="24,16" BorderBrush="#3A3A5C" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Step 1 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}"
                            Background="{Binding IsStep1, Converter={x:Static local:BoolToAccentConverter.Instance}}">
                        <TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Archivo Excel" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Step1Completed, Converter={x:Static local:BoolToAccentConverter.Instance}}"/>
                </StackPanel>
                <Rectangle Width="40" Height="1" Fill="#3A3A5C" Margin="12,0"/>
                <!-- Step 2 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}"
                            Background="{Binding IsStep2, Converter={x:Static local:BoolToAccentConverter.Instance}}">
                        <TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Fuentes de Búsqueda" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Step2Completed, Converter={x:Static local:BoolToAccentConverter.Instance}}"/>
                </StackPanel>
                <Rectangle Width="40" Height="1" Fill="#3A3A5C" Margin="12,0"/>
                <!-- Step 3 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}"
                            Background="{Binding IsStep3, Converter={x:Static local:BoolToAccentConverter.Instance}}">
                        <TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Prioridad de Fuentes" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{Binding Step3Completed, Converter={x:Static local:BoolToAccentConverter.Instance}}"/>
                </StackPanel>
                <Rectangle Width="40" Height="1" Fill="#3A3A5C" Margin="12,0"/>
                <!-- Step 4 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource StepCircle}"
                            Background="{Binding IsStep4, Converter={x:Static local:BoolToAccentConverter.Instance}}">
                        <TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <TextBlock Text="Ejecución" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="#94A3B8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ── Step Content Area ── -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentStepViewModel}" Margin="0"/>

        <!-- ── Error Banner ── -->
        <Border Grid.Row="1" VerticalAlignment="Bottom" Margin="24,0,24,8"
                Background="#7F1D1D" CornerRadius="6" Padding="12,8"
                Visibility="{Binding HasError, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FCA5A5" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- ── Navigation Buttons ── -->
        <Border Grid.Row="2" Background="#2A2A3E" Padding="24,12" BorderBrush="#3A3A5C" BorderThickness="0,1,0,0">
            <Grid>
                <Button Content="← Atrás" Style="{StaticResource SecondaryButton}"
                        Command="{Binding BackCommand}"
                        HorizontalAlignment="Left"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Content="Continuar →" Style="{StaticResource PrimaryButton}"
                            Command="{Binding NextCommand}"
                            Visibility="{Binding IsStep4, Converter={x:Static local:BoolToInverseVisibilityConverter.Instance}}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
