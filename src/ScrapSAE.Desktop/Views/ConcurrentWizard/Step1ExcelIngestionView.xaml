<UserControl x:Class="ScrapSAE.Desktop.Views.ConcurrentWizard.Step1ExcelIngestionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScrapSAE.Desktop.Infrastructure"
             Background="#1E1E2E" Foreground="White" Padding="24">

    <UserControl.Resources>
        <!-- ── Dark ComboBox Style & Template ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#7C3AED"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="#2A2A3E"
                                        BorderBrush="#7C3AED"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer x:Name="DropDownScrollViewer" Margin="2">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6">
                                            <Path x:Name="Arrow"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="#C4B5FD"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#A78BFA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#2A2A3E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#7C3AED"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#6D28D9"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#DDD6FE"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="#3A3A5C"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A5C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Paso 1: Cargar Archivo Excel" FontSize="20" FontWeight="Bold"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Selecciona el archivo Excel del proveedor y mapea las columnas obligatorias."
                       Foreground="#94A3B8" FontSize="13" Margin="0,0,0,20"/>

            <!-- ── Drop Zone / File Selector ── -->
            <Border Background="#2A2A3E" CornerRadius="8" Padding="24" Margin="0,0,0,20"
                    BorderBrush="#3A3A5C" BorderThickness="2" AllowDrop="True"
                    Drop="Border_Drop" DragOver="Border_DragOver">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock Text="Arrastra tu archivo Excel aquí o" HorizontalAlignment="Center"
                               Foreground="#94A3B8" FontSize="13"/>
                    <Button Content="Seleccionar archivo" Margin="0,12,0,0"
                            Command="{Binding LoadFileCommand}"
                            HorizontalAlignment="Center"
                            Background="#7C3AED" Foreground="White" Padding="16,8"
                            BorderThickness="0" Cursor="Hand"/>
                    <TextBlock Text="{Binding FilePath}" Margin="0,8,0,0"
                               Foreground="#DDD6FE" FontSize="11" TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Visibility="{Binding HasFile, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                </StackPanel>
            </Border>

            <!-- ── Status / Error ── -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="#10B981" FontSize="12" Margin="0,0,0,8"
                       Visibility="{Binding HasFile, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12"
                       Visibility="{Binding HasError, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                       TextWrapping="Wrap"/>

            <!-- ── Target Site (Provider) ── -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Proveedor Destino *" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Selecciona a qué proveedor pertenecen estos productos (obligatorio)." Foreground="#94A3B8" FontSize="12" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding AvailableSites}"
                          SelectedItem="{Binding SelectedSite, Mode=TwoWay}"
                          DisplayMemberPath="Name"
                          Width="400" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- ── Column Mapping (solo si hay archivo) ── -->
            <StackPanel Visibility="{Binding HasFile, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                <TextBlock Text="Mapa de Columnas" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- SKU -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Columna SKU *" Foreground="#DDD6FE" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ColumnHeaders}"
                                  SelectedIndex="{Binding SkuColumnIndex, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Costo Proveedor -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Costo del Proveedor *" Foreground="#DDD6FE" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ColumnHeaders}"
                                  SelectedIndex="{Binding CostColumnIndex, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Margen % (opcional) -->
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Margen % (opcional)" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ColumnHeaders}"
                                  SelectedIndex="{Binding MarginColumnIndex, Mode=TwoWay}"/>
                    </StackPanel>

                    <!-- Categoría (opcional) -->
                    <StackPanel Grid.Column="6">
                        <TextBlock Text="Categoría (opcional)" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding ColumnHeaders}"
                                  SelectedIndex="{Binding CategoryColumnIndex, Mode=TwoWay}"/>
                    </StackPanel>
                </Grid>

                <!-- ── Preview Table ── -->
                <TextBlock Text="Vista previa (primeras 10 filas)" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,0,8"/>
                <Border BorderBrush="#3A3A5C" BorderThickness="1" CornerRadius="6">
                    <DataGrid ItemsSource="{Binding PreviewView}"
                              AutoGenerateColumns="True"
                              IsReadOnly="True"
                              Background="#2A2A3E" Foreground="White"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              MaxHeight="220"
                              RowBackground="#252537"
                              AlternatingRowBackground="#2A2A3E"
                              BorderThickness="0"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
