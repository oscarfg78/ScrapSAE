<UserControl x:Class="ScrapSAE.Desktop.Views.ConcurrentWizard.Step4ExecutionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScrapSAE.Desktop.Infrastructure"
             Background="#1E1E2E" Foreground="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Summary Bar -->
            <RowDefinition Height="*"/>     <!-- Live Results -->
            <RowDefinition Height="Auto"/>  <!-- Control Toolbar -->
        </Grid.RowDefinitions>

        <!-- ── Summary Bar ── -->
        <Border Grid.Row="0" Background="#2A2A3E" Padding="24,16" BorderBrush="#3A3A5C" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding StatusMessage}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="6"
                                 Background="#3A3A5C" Foreground="#7C3AED"/>
                </StackPanel>

                <!-- Counters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                    <Border Background="#1E3A2F" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SuccessCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="#10B981" HorizontalAlignment="Center"/>
                            <TextBlock Text="Encontrados" Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#3B1919" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding SkippedCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="#EF4444" HorizontalAlignment="Center"/>
                            <TextBlock Text="Omitidos" Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A2A3E" CornerRadius="6" Padding="12,8" Margin="0,0,8,0">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ProcessedCount}" FontSize="20" FontWeight="Bold"
                                       Foreground="#A78BFA" HorizontalAlignment="Center"/>
                            <TextBlock Text="Procesados" Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#2A2A3E" CornerRadius="6" Padding="12,8">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding ElapsedTime}" FontSize="20" FontWeight="Bold"
                                       Foreground="#F59E0B" HorizontalAlignment="Center"/>
                            <TextBlock Text="Tiempo" Foreground="#94A3B8" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Live Results Grid ── -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,16">
            <ItemsControl ItemsSource="{Binding LiveResults}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="220" Margin="0,0,12,12" CornerRadius="8" Padding="14"
                                Background="#2A2A3E" BorderBrush="#3A3A5C" BorderThickness="1">
                            <StackPanel>
                                <!-- Imagen -->
                                <Border Height="100" CornerRadius="4" Background="#1E1E2E" Margin="0,0,0,8"
                                        ClipToBounds="True">
                                    <Image Source="{Binding FirstImageUrl}" Stretch="Uniform"/>
                                </Border>

                                <!-- Status badge and View Button -->
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={x:Static local:StatusToColorConverter.Instance}}">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                    
                                    <Button Grid.Column="1" Content="👁 Ver" 
                                            Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                            CommandParameter="{Binding}"
                                            Background="#4F46E5" Foreground="White" BorderThickness="0" 
                                            Padding="6,2" FontSize="10" Cursor="Hand" FontWeight="SemiBold" />
                                </Grid>

                                <!-- SKU -->
                                <TextBlock Text="{Binding Sku}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#A78BFA" TextTrimming="CharacterEllipsis"/>
                                <!-- Title -->
                                <TextBlock Text="{Binding Title}" FontSize="11" Foreground="#94A3B8"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,8"/>

                                <!-- Prices -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/><ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Costo" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding CostDisplay}" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Precio público" Foreground="#64748B" FontSize="10"/>
                                        <TextBlock Text="{Binding PriceDisplay}" Foreground="#10B981" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Warning Message -->
                                <TextBlock Text="{Binding WarningMessage}" Foreground="#F59E0B" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding HasWarning, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ── Control Toolbar ── -->
        <Border Grid.Row="2" Background="#2A2A3E" Padding="24,12" BorderBrush="#3A3A5C" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="▶ Iniciar" Command="{Binding StartCommand}"
                        Background="#059669" Foreground="White" Padding="16,8" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="⏸ Pausar" Command="{Binding PauseCommand}"
                        Background="#D97706" Foreground="White" Padding="16,8" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="▶ Reanudar" Command="{Binding ResumeCommand}"
                        Background="#059669" Foreground="White" Padding="16,8" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="⏹ Detener" Command="{Binding StopCommand}"
                        Background="#DC2626" Foreground="White" Padding="16,8" BorderThickness="0" Cursor="Hand"
                        FontWeight="SemiBold" Margin="0,0,24,0"/>
                <Button Content="📥 Exportar resultados" Command="{Binding ExportCommand}"
                        Background="#2A2A3E" Foreground="#A78BFA" Padding="16,8"
                        BorderBrush="#7C3AED" BorderThickness="1" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="💾 Guardar en BD" Command="{Binding SaveToDatabaseCommand}"
                        Background="#6D28D9" Foreground="White" Padding="16,8"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <Button Content="⚡ Sincronizar Flashly" Command="{Binding OpenFlashlySyncCommand}"
                        Background="#7C3AED" Foreground="White" Padding="16,8"
                        BorderThickness="0" Cursor="Hand" FontWeight="SemiBold" Margin="0,0,24,0"/>
                
                <!-- Retry controls -->
                <Border Background="#1E1E2E" BorderBrush="#3A3A5C" BorderThickness="1" CornerRadius="4" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Índice:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBox Text="{Binding RetryIndex, UpdateSourceTrigger=PropertyChanged}" Width="50" 
                                 Background="#2A2A3E" Foreground="White" BorderBrush="#3A3A5C" Padding="4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Reintentar desde aquí" Command="{Binding RetryFromIndexCommand}"
                                Background="#4C1D95" Foreground="White" Padding="12,6" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
