{
  "name": "scrapsae-extension",
  "version": "1.0.0",
  "description": "ScrapSAE Chrome Extension - Extract product data to Excel",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@vitest/coverage-v8": "^3.2.4",
    "jsdom": "^29.0.1",
    "typescript": "^5.4.0",
    "vite": "^8.0.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "xlsx": "^0.18.5"
  }
}
